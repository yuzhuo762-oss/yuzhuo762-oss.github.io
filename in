/* --- Pseudo-3D Hero Layers --- */
.hero-3d-layer {
  position: absolute;
  pointer-events: none;
  z-index: 0;
  will-change: transform;
}

.hero-3d-layer.layer-far {
  top: 10%; left: 5%;
  width: 90%; height: 80%;
  background: radial-gradient(ellipse at 30% 40%, rgba(0,212,255,0.06) 0%, transparent 50%);
  z-index: 0;
}

.hero-3d-layer.layer-mid {
  top: 20%; right: 10%;
  width: 300px; height: 300px;
  border: 1px solid rgba(0,212,255,0.08);
  border-radius: 50%;
  z-index: 0;
}

.hero-3d-layer.layer-near {
  bottom: 15%; left: 10%;
  width: 200px; height: 200px;
  border: 1px solid rgba(124,58,237,0.08);
  border-radius: 50%;
  z-index: 0;
}

/* --- Circle Reveal (Mask) --- */
.circle-reveal {
  clip-path: circle(0% at 50% 50%);
  transition: clip-path 1.4s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: clip-path;
}
.circle-reveal.revealed {
  clip-path: circle(100% at 50% 50%);
}

/* --- Diagonal Slide Reveal --- */
.diagonal-reveal {
  clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
  transition: clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: clip-path;
}
.diagonal-reveal.revealed {
  clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
}

/* --- Wipe Reveal (Gradient Mask Slide) --- */
.wipe-reveal {
  position: relative;
  display: inline-block;
  overflow: hidden;
}
.wipe-reveal::after {
  content: '';
  position: absolute;
  top: 0; right: 0;
  width: 100%; height: 100%;
  background: linear-gradient(90deg, var(--bg-primary) 0%, var(--bg-primary) 100%);
  transform-origin: right;
  transform: scaleX(1);
  transition: transform 1s cubic-bezier(0.16, 1, 0.3, 1);
}
.wipe-reveal.revealed::after {
  transform: scaleX(0);
}

/* --- Growth Scale Animation --- */
.grow-in {
  opacity: 0;
  transform: scale(0.3);
  transition: all 0.9s cubic-bezier(0.34, 1.56, 0.64, 1);
  will-change: transform, opacity;
}
.grow-in.revealed {
  opacity: 1;
  transform: scale(1);
}



/* --- 3D Perspective Card (Stronger) --- */
.card-3d {
  perspective: 1200px;
}
.card-3d-inner {
  transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  transform-style: preserve-3d;
  will-change: transform;
}
.card-3d-inner:hover {
  transform: rotateY(8deg) rotateX(-4deg) translateZ(20px);
}

/* --- Floating Depth Elements --- */
.float-depth {
  animation: floatDepth 6s ease-in-out infinite;
  will-change: transform;
}
@keyframes floatDepth {
  0%, 100% { transform: translateY(0) scale(1); }
  50% { transform: translateY(-15px) scale(1.02); }
}

.float-depth-delayed {
  animation: floatDepth 7s ease-in-out 1s infinite;
}

/* --- Text Blur Reveal --- */
.blur-reveal {
  filter: blur(10px);
  opacity: 0;
  transition: all 1s cubic-bezier(0.16, 1, 0.3, 1);
}
.blur-reveal.revealed {
  filter: blur(0);
  opacity: 1;
}

/* --- Stagger Children Animation --- */
.stagger-children > * {
  opacity: 0;
  transform: translateY(20px);
  transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
}
.stagger-children.revealed > *:nth-child(1) { transition-delay: 0s; opacity: 1; transform: translateY(0); }
.stagger-children.revealed > *:nth-child(2) { transition-delay: 0.1s; opacity: 1; transform: translateY(0); }
.stagger-children.revealed > *:nth-child(3) { transition-delay: 0.2s; opacity: 1; transform: translateY(0); }
.stagger-children.revealed > *:nth-child(4) { transition-delay: 0.3s; opacity: 1; transform: translateY(0); }
.stagger-children.revealed > *:nth-child(5) { transition-delay: 0.4s; opacity: 1; transform: translateY(0); }
.stagger-children.revealed > *:nth-child(6) { transition-delay: 0.5s; opacity: 1; transform: translateY(0); }
.stagger-children.revealed > *:nth-child(7) { transition-delay: 0.6s; opacity: 1; transform: translateY(0); }
.stagger-children.revealed > *:nth-child(8) { transition-delay: 0.7s; opacity: 1; transform: translateY(0); }

/* --- Section Morph Transition --- */
.section-morph {
  position: relative;
}
.section-morph::before {
  content: '';
  position: absolute;
  top: -2px; left: 0; right: 0;
  height: 4px;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(0,212,255,0.1) 20%, 
    rgba(124,58,237,0.15) 50%, 
    rgba(0,212,255,0.1) 80%, 
    transparent 100%
  );
  opacity: 0;
  transition: opacity 1s ease;
}
.section-morph.in-view::before {
  opacity: 1;
}

/* --- Card Stack Depth --- */
.card-stack {
  position: relative;
}
.card-stack::before {
  content: '';
  position: absolute;
  top: 4px; left: 4px; right: -2px; bottom: -2px;
  background: rgba(0,212,255,0.03);
  border-radius: var(--radius-md);
  z-index: -1;
  transition: all 0.3s ease;
}
.card-stack::after {
  content: '';
  position: absolute;
  top: 8px; left: 8px; right: -4px; bottom: -4px;
  background: rgba(124,58,237,0.02);
  border-radius: var(--radius-md);
  z-index: -2;
  transition: all 0.3s ease;
}
.card-stack:hover::before {
  top: 6px; left: 6px;
  background: rgba(0,212,255,0.06);
}
.card-stack:hover::after {
  top: 12px; left: 12px;
  background: rgba(124,58,237,0.04);
}

/* --- Gallery item with circle reveal --- */
.gallery-item.circle-reveal-wrap {
  overflow: hidden;
}
.gallery-item.circle-reveal-wrap img {
  clip-path: circle(0% at 50% 50%);
  transition: clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.gallery-item.circle-reveal-wrap.revealed img {
  clip-path: circle(100% at 50% 50%);
}

/* --- Project list item with line draw --- */
.timeline-item {
  position: relative;
  padding-left: 1.5rem;
}
.timeline-item .draw-line-v-fill {
  position: absolute;
  left: -0.5px; top: 0;
  width: 2px;
}

/* --- Work card image with circle reveal --- */
.work-card-image.circle-reveal-wrap {
  overflow: hidden;
}
.work-card-image.circle-reveal-wrap img {
  clip-path: circle(0% at 50% 50%);
  transition: clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1);
}
.work-card-image.circle-reveal-wrap.revealed img {
  clip-path: circle(100% at 50% 50%);
}

/* --- Animated glowing dot --- */
.glow-dot {
  display: inline-block;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--accent-cyan);
  margin-right: 6px;
  animation: glowDot 2s ease-in-out infinite;
  vertical-align: middle;
}
@keyframes glowDot {
  0%, 100% { box-shadow: 0 0 4px rgba(0,212,255,0.3); transform: scale(1); }
  50% { box-shadow: 0 0 12px rgba(0,212,255,0.6); transform: scale(1.3); }
}

/* --- Responsive --- */
@media (max-width: 768px) {
  .hero-3d-layer { display: none; }
  .card-stack::before, .card-stack::after { display: none; }
  .draw-line-wrap { display: none; }
}

/* ===========================
   鼠标交互增强 · 自定义光标 · 聚光灯
   =========================== */


/* --- Vignette Spotlight --- */
.mouse-vignette {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  z-index: 9996;
  pointer-events: none;
  transition: background 0.1s ease;
  will-change: background;
}

/* --- Click Ripple --- */
.click-ripple {
  position: fixed;
  width: 0;
  height: 0;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(0,212,255,0.3), transparent);
  pointer-events: none;
  z-index: 99999;
  transform: translate(-50%, -50%);
  animation: rippleExpand 0.8s ease-out forwards;
}
@keyframes rippleExpand {
  0% { width: 0; height: 0; opacity: 0.6; }
  100% { width: 300px; height: 300px; opacity: 0; }
}

/* --- Diagonal Reveal (Replaces Circle Reveal) --- */
.diagonal-reveal {
  clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
  transition: clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: clip-path;
}
.diagonal-reveal.revealed {
  clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
}

.gallery-item.diagonal-reveal,
.work-card-image.diagonal-reveal {
  overflow: hidden;
}
.gallery-item.diagonal-reveal img,
.work-card-image.diagonal-reveal img {
  clip-path: polygon(0 0, 0 0, 0 100%, 0 100%);
  transition: clip-path 1.2s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: clip-path;
}
.gallery-item.diagonal-reveal.revealed img,
.work-card-image.diagonal-reveal.revealed img {
  clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%);
}

/* --- Card Breathing (subtle float) --- */
.breathing {
  animation: breathe 4s ease-in-out infinite;
  will-change: transform;
}
@keyframes breathe {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-4px); }
}
.breathing-delayed {
  animation: breathe 4.5s ease-in-out 0.5s infinite;
}

/* --- Strong hover scale on interactive elements --- */
.work-card:hover {
  transform: scale(1.02) !important;
}

/* --- Nav link hover strong --- */
.nav-links a:hover {
  transform: translateY(-1px);
}


  a, button, .btn, .gallery-item, .work-card, .filter-btn,
  .nav-hamburger, .close { cursor: pointer !important; }
  
}


/* --- Hero Name & Tagline --- */
.hero-name {
  display: inline-block;
  font-size: clamp(3rem, 8vw, 5.5rem);
  font-weight: 900;
  color: #FFFFFF;
  text-shadow: 
    0 0 20px rgba(0, 212, 255, 0.3),
    0 0 60px rgba(0, 212, 255, 0.1);
  letter-spacing: -0.03em;
  line-height: 1.05;
  animation: heroGlow 3s ease-in-out infinite;
}
@keyframes heroGlow {
  0%, 100% { text-shadow: 0 0 20px rgba(0, 212, 255, 0.3), 0 0 60px rgba(0, 212, 255, 0.1); }
  50% { text-shadow: 0 0 30px rgba(0, 212, 255, 0.5), 0 0 80px rgba(0, 212, 255, 0.2), 0 0 120px rgba(124, 58, 237, 0.1); }
}

.hero-tagline {
  display: inline-block;
  font-size: clamp(2.2rem, 6vw, 4rem);
  font-weight: 900;
  background: linear-gradient(135deg, #00D4FF 0%, #60EFFF 30%, #FFFFFF 50%, #A78BFA 70%, #7C3AED 100%);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
  animation: taglineFlow 5s ease-in-out infinite;
  letter-spacing: -0.02em;
  line-height: 1.1;
  filter: drop-shadow(0 0 15px rgba(0, 212, 255, 0.2));
}
@keyframes taglineFlow {
  0% { background-position: 0% 50%; }
  25% { background-position: 50% 0%; }
  50% { background-position: 100% 50%; }
  75% { background-position: 50% 100%; }
  100% { background-position: 0% 50%; }
}

